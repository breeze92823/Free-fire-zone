# Skips the Bloxity SDK (sdk.bloxity.io) and avatar CDN (static.bloxity.io) so local dev never depends on them.
VITE_DEV_MODE=false

# Online play without the Bloxity SDK (VITE_DEV_MODE=true): the game server to connect to.
# Default: ws://<this host>:2567 (the backend's `npm start`). Two local players: open a second
# tab with ?devUser=dev-someone2 (dev builds only).
# VITE_SERVER_URL=ws://localhost:2567
